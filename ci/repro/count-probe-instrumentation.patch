+// ---- COUNT(*) durable probe counters (starvation-tolerant via an OS thread) ----
+pub(crate) mod count_probe {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::sync::OnceLock;
+    pub static RS: AtomicU64 = AtomicU64::new(0); // route_select reached (count-only)
+    pub static RSUT: AtomicU64 = AtomicU64::new(0); // route_select_user_table reached
+    pub static FAST: AtomicU64 = AtomicU64::new(0); // ADR-020 fast path taken
+    pub static STREAM: AtomicU64 = AtomicU64::new(0); // streaming count branch taken
+    pub static STREAM_CALLS: AtomicU64 = AtomicU64::new(0); // count_rows_from_partition_stream calls
+    pub static STREAM_MIN_PARTS: AtomicU64 = AtomicU64::new(u64::MAX); // min partitions a stream yielded
+    pub static EARLY_OTHER: AtomicU64 = AtomicU64::new(0); // RSUT count-only that returned before fast-path check
+    pub static ALL_SELECT: AtomicU64 = AtomicU64::new(0); // every Statement::Select reaching route()
+    pub static ALL_COUNT_SELECT: AtomicU64 = AtomicU64::new(0); // count-only Selects reaching route()
+    // Frame-level (connection layer, before route): how the request arrived.
+    pub static QFRAMES: AtomicU64 = AtomicU64::new(0); // QUERY frames
+    pub static QCOUNT: AtomicU64 = AtomicU64::new(0); // QUERY frames that parse to count-only SELECT
+    pub static EFRAMES: AtomicU64 = AtomicU64::new(0); // EXECUTE frames (prepared)
+    pub static ECOUNT: AtomicU64 = AtomicU64::new(0); // EXECUTE frames whose plan is a count-only SELECT
+    pub static PFRAMES: AtomicU64 = AtomicU64::new(0); // PREPARE frames
+    pub static BFRAMES: AtomicU64 = AtomicU64::new(0); // BATCH frames
+
+    pub fn enabled() -> bool {
+        static EN: OnceLock<bool> = OnceLock::new();
+        *EN.get_or_init(|| std::env::var("FERROSA_COUNT_PROBE").is_ok())
+    }
+
+    pub fn min_parts(p: u64) {
+        let mut cur = STREAM_MIN_PARTS.load(Ordering::Relaxed);
+        while p < cur {
+            match STREAM_MIN_PARTS.compare_exchange_weak(cur, p, Ordering::Relaxed, Ordering::Relaxed) {
+                Ok(_) => break,
+                Err(x) => cur = x,
+            }
+        }
+    }
+
+    pub fn start_dumper() {
+        static STARTED: OnceLock<()> = OnceLock::new();
+        STARTED.get_or_init(|| {
+            std::thread::spawn(|| loop {
+                let s = format!(
+                    "QFRAMES={} QCOUNT={} EFRAMES={} ECOUNT={} PFRAMES={} BFRAMES={} | ALL_SELECT={} ALL_COUNT_SELECT={} RS={} RSUT={} FAST={} STREAM={} STREAM_CALLS={} STREAM_MIN_PARTS={} EARLY_OTHER={}\n",
+                    QFRAMES.load(Ordering::Relaxed),
+                    QCOUNT.load(Ordering::Relaxed),
+                    EFRAMES.load(Ordering::Relaxed),
+                    ECOUNT.load(Ordering::Relaxed),
+                    PFRAMES.load(Ordering::Relaxed),
+                    BFRAMES.load(Ordering::Relaxed),
+                    ALL_SELECT.load(Ordering::Relaxed),
+                    ALL_COUNT_SELECT.load(Ordering::Relaxed),
+                    RS.load(Ordering::Relaxed),
+                    RSUT.load(Ordering::Relaxed),
+                    FAST.load(Ordering::Relaxed),
+                    STREAM.load(Ordering::Relaxed),
+                    STREAM_CALLS.load(Ordering::Relaxed),
+                    STREAM_MIN_PARTS.load(Ordering::Relaxed),
+                    EARLY_OTHER.load(Ordering::Relaxed),
+                );
+                let _ = std::fs::write("/tmp/ferrosa-count-counters.txt", s);
+                std::thread::sleep(std::time::Duration::from_millis(200));
+            });
+        });
+    }
+}
