# Tunables for the fly streaming-scan memory harness. Sourced by the *.sh scripts.
# All overridable from the environment.

# Fly app + placement.
FLY_APP="${FLY_APP:-ferrosa-stream-scan}"
FLY_REGION="${FLY_REGION:-lax}"
FLY_ORG="${FLY_ORG:-ferrosa}"

# Cluster shape. N>=3 distinct machines => distinct private IPs (address-agnostic).
NODE_COUNT="${NODE_COUNT:-3}"
REPLICATION_FACTOR="${REPLICATION_FACTOR:-3}"

# HARD CONSTRAINT: 2 GiB per node. Never raise — it is the assertion (see README).
VM_MEMORY_MB="${VM_MEMORY_MB:-2048}"
VM_CPUS="${VM_CPUS:-shared-cpu-1x}"

# Image: built from this git ref, same pattern as fly-bench.
BENCH_GIT_REF="${BENCH_GIT_REF:-HEAD}"

# Seed sizes — well past the page size (>=50k partitions, >=3 pages) per spec.
SEED_PARTITIONS="${SEED_PARTITIONS:-50000}"
SEED_SNIPPET_BYTES="${SEED_SNIPPET_BYTES:-2048}"
SEED_EDGES="${SEED_EDGES:-50000}"

# CQL page size the coordinated projected paged scan uses.
CQL_PAGE_SIZE="${CQL_PAGE_SIZE:-5000}"

# Probe wall-clock cap: a hang/deadlock must FAIL, not hang the run.
PROBE_TIMEOUT_SECS="${PROBE_TIMEOUT_SECS:-600}"

# Per-node RSS ceiling asserted throughout every probe (bytes). 2 GiB.
NODE_RSS_CEILING_BYTES="${NODE_RSS_CEILING_BYTES:-2147483648}"
