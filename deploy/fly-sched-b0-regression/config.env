# Tunables for the scheduler-B0 no-step-down regression (task t_88223ad0 / T0.6).
# Sourced by the *.sh scripts. All overridable from the environment.
#
# GOAL: prove the bounded scheduler pool (B0) keeps the Raft leader from being
# starved out under a full-table ALLOW FILTERING scan storm. Two arms:
#   - PRE-FIX  nodes built from origin/main BEFORE B0 (no bounded pool): the
#     scan storm must REPRODUCE a leader step-down (non-vacuous gate).
#   - POST-FIX nodes built from the B0 branch HEAD: the same storm must stay
#     GREEN — leader term stable, election-storm counter 0, consensus headroom > 0.
#
# Unlike the O_DIRECT baseline (which PINS dedicated `performance` CPUs to avoid
# scheduling noise), this regression WANTS the shared-CPU throttle: a shared vCPU
# is capped at ~6.5% and is the race fuzzer that makes the raft thread starvable
# when hundreds of unbounded blocking scan threads oversubscribe the core.

# ── Fly placement (per-arm apps keep the two clusters fully isolated) ─────────
FLY_ORG="${FLY_ORG:-ferrosa}"
FLY_REGION="${FLY_REGION:-lax}"
FLY_APP_PREFIX="${FLY_APP_PREFIX:-ferrosa-schedb0}"          # -> <prefix>-prefix / <prefix>-postfix
# FLY_APP is set per-arm by run-all.sh (do not hardcode here). lib.sh requires it.

# ── Cluster shape ─────────────────────────────────────────────────────────────
NODE_COUNT="${NODE_COUNT:-3}"
REPLICATION_FACTOR="${REPLICATION_FACTOR:-3}"

# SHARED-CPU on purpose (the ~6.5% throttle = the starvation race fuzzer).
VM_CPUS="${VM_CPUS:-shared-cpu-1x}"
VM_MEMORY_MB="${VM_MEMORY_MB:-2048}"                          # shared-cpu-1x max

# Load driver: a bigger box so the CLIENT is never the bottleneck; it must be
# able to open scan-concurrency sessions and keep them saturated.
CLIENT_VM_CPUS="${CLIENT_VM_CPUS:-performance-2x}"
CLIENT_VM_MEMORY_MB="${CLIENT_VM_MEMORY_MB:-4096}"

# ── Build refs ────────────────────────────────────────────────────────────────
# Post-fix = this branch HEAD (bounded pool + scan-storm loadgen + raft metrics).
# Pre-fix  = origin/main before B0 (parent of the first B0 commit).
POSTFIX_REF="${POSTFIX_REF:-HEAD}"
PREFIX_REF="${PREFIX_REF:-3974482c}"
# The driver (loadgen --scan-storm) only exists on the B0 branch, so BOTH arms
# drive load with the POST-FIX image's loadgen on the client node.
RUN_PREFIX_ARM="${RUN_PREFIX_ARM:-1}"                        # set 0 to skip the repro arm

# ── Workload sizing ───────────────────────────────────────────────────────────
# Seed the scan target (write_heavy fills load_test.data via the profile sizes).
SEED_SECS="${SEED_SECS:-180}"
# Scan storm: many concurrent full-table ALLOW FILTERING scans. On a 1-vCPU box
# the PRE-FIX build admits up to tokio's default 512 blocking scan threads; a
# high worker count guarantees the oversubscription that starves raft.
SCAN_CONCURRENCY="${SCAN_CONCURRENCY:-64}"
STORM_SECS="${STORM_SECS:-300}"

# Metrics/log sampler cadence (seconds) on each node during the storm.
SAMPLE_INTERVAL_SECS="${SAMPLE_INTERVAL_SECS:-2}"

# Run wall-clock cap: a hang must FAIL the run, never stall the harness.
RUN_TIMEOUT_SECS="${RUN_TIMEOUT_SECS:-2400}"

# ── Local output ──────────────────────────────────────────────────────────────
OUT_DIR="${OUT_DIR:-target/fly-sched-b0-regression}"

# ── Gate thresholds ───────────────────────────────────────────────────────────
# POST-FIX is GREEN iff, across the whole storm window on every node:
#   - ferrosa_raft_election_storm_term_jumps_total stays == 0
#   - ferrosa_raft_current_term is stable (max-min <= this slack; 0 = never moved)
#   - ferrosa_sched_consensus_headroom_cores stays >= this floor (> 0)
#   - /readyz never drops the leader; no step-down log substrings
GATE_TERM_DRIFT_MAX="${GATE_TERM_DRIFT_MAX:-0}"
GATE_HEADROOM_MIN="${GATE_HEADROOM_MIN:-1}"
# PRE-FIX arm REPRODUCES iff any of: storm-log substrings appear, /readyz drops
# the leader, or a re-election is observed. (Pre-fix images lack the ferrosa_raft
# metrics, so its detection is log + readiness based.)
STEPDOWN_LOG_PATTERNS="${STEPDOWN_LOG_PATTERNS:-election storm detected|quorum lost|raft leader elected|seen a greater log id}"
