    Source: 'ferrosa-common/src/cluster_join.rs', lines 139:0-157:1
    Visibility: public -/
def cluster_join.answer_membership
  (knowledge : cluster_join.PeerKnowledge) :
  Result cluster_join.MembershipAnswer
  := do
  if knowledge.has_quorum
  then
    match knowledge.decommissioned with
    | none =>
      if knowledge.in_committed_membership
      then
        ok (cluster_join.MembershipAnswer.Member (¬
          knowledge.quorum_without_asker)
          knowledge.earliest_available_log_index)
      else ok cluster_join.MembershipAnswer.NotAMember
    | some p =>
      let («at», «by») := p
      let s ← alloc.string.String.Insts.CoreCloneClone.clone «by»
      ok (cluster_join.MembershipAnswer.Decommissioned «at» s)
  else ok cluster_join.MembershipAnswer.NoQuorum

/-- [ferrosa_common::cluster_join::plan_join]:
    Source: 'ferrosa-common/src/cluster_join.rs', lines 165:0-191:1
    Visibility: public -/
def cluster_join.plan_join
  (answer : cluster_join.MembershipAnswer)
  (local_last_log_index : Option Std.U64) :
  Result cluster_join.JoinAction
  := do
  match answer with
  | cluster_join.MembershipAnswer.NoQuorum =>
    ok cluster_join.JoinAction.WaitAndRetry
  | cluster_join.MembershipAnswer.NotAMember =>
    ok cluster_join.JoinAction.FormStandalone
  | cluster_join.MembershipAnswer.Decommissioned «at» «by» =>
    let s ← alloc.string.String.Insts.CoreCloneClone.clone «by»
    ok (cluster_join.JoinAction.RefuseDecommissioned «at» s)
  | cluster_join.MembershipAnswer.Member _ earliest_available_log_index =>
    match local_last_log_index with
    | none =>
      ok (cluster_join.JoinAction.Rejoin
        cluster_join.CatchUp.StreamOwnedTokens)
    | some «local» =>
      match earliest_available_log_index with
      | none =>
        ok (cluster_join.JoinAction.Rejoin cluster_join.CatchUp.RaftLog)
      | some earliest =>
        let i ← «local» + 1#u64
        if i < earliest
        then
          ok (cluster_join.JoinAction.Rejoin
            cluster_join.CatchUp.StreamOwnedTokens)
        else ok (cluster_join.JoinAction.Rejoin cluster_join.CatchUp.RaftLog)

