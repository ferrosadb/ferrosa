+/// BT-004: Boot server, create schema via CQL, snapshot schema to disk,
+/// verify the snapshot file exists and contains the user-created keyspace/table.
+#[tokio::test]
+async fn bt004_schema_persisted_after_ddl() {
+    let (mut client, state, dir) = boot_and_connect().await;
+
+    // Create keyspace and table via CQL.
+    client
+        .query("CREATE KEYSPACE lifecycle_ks WITH replication = {'class': 'SimpleStrategy', 'replication_factor': '1'}")
+        .await
+        .unwrap();
+    client
+        .query("CREATE TABLE lifecycle_ks.events (id text PRIMARY KEY, data text)")
+        .await
+        .unwrap();
+
+    // Verify the table is queryable.
+    client
+        .query("INSERT INTO lifecycle_ks.events (id, data) VALUES ('e1', 'test')")
+        .await
+        .unwrap();
+    let result = client
+        .query("SELECT * FROM lifecycle_ks.events WHERE id = 'e1'")
+        .await
+        .unwrap();
+    assert!(!result.rows.is_empty(), "inserted row must be readable");
+
+    // Persist schema to disk (same as main.rs shutdown path).
+    let snapshot = state.schema.snapshot();
+    let json = serde_json::to_vec_pretty(&snapshot).unwrap();
+    let schema_path = dir.path().join("schema.json");
+    std::fs::write(&schema_path, &json).unwrap();
+
+    // Verify the persisted schema contains our keyspace and table.
+    let data = std::fs::read(&schema_path).unwrap();
+    let restored: ferrosa_schema::SchemaSnapshot = serde_json::from_slice(&data).unwrap();
+    assert!(
+        restored.keyspaces.contains_key("lifecycle_ks"),
+        "persisted schema must contain lifecycle_ks"
+    );
+    let ks = &restored.keyspaces["lifecycle_ks"];
+    assert_eq!(ks.name, "lifecycle_ks");
+}
