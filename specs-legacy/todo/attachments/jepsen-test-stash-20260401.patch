+        assert_eq!(result.ok_count, 150);
+        assert_eq!(result.info_count, 5);
+    }
+
+    #[test]
+    fn knossos_result_serialization_roundtrip() {
+        let result = KnossosResult {
+            valid: false,
+            model: "cas-register".into(),
+            algorithm: "wgl".into(),
+            ok_count: 10,
+            fail_count: 2,
+            info_count: 1,
+            anomalies: vec![KnossosAnomaly {
+                anomaly_type: "linearizability-violation".into(),
+                description: "stale read".into(),
+            }],
+        };
+        let json = serde_json::to_string(&result).unwrap();
+        let back: KnossosResult = serde_json::from_str(&json).unwrap();
+        assert!(!back.valid);
+        assert_eq!(back.ok_count, 10);
+        assert_eq!(back.anomalies.len(), 1);
