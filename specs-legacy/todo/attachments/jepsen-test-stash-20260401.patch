+        let output: Vec<u8> = vec![
+            0xFF, 0xFE, b':', b'v', b'a', b'l', b'i', b'd', b'?', b' ', b't', b'r', b'u', b'e',
+        ];
+        let result = KnossosChecker::parse_output(&output).unwrap();
+        assert!(result.valid);
+    }
 }
