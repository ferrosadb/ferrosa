+        );
+    }
+
+    #[test]
+    fn extract_count_no_digits_after_key() {
+        // Key present but no digits following it.
+        assert_eq!(
+            KnossosChecker::extract_count(":ok-count abc", ":ok-count"),
+            0
+        );
+    }
+
+    #[test]
+    fn extract_count_key_at_end_of_text() {
+        assert_eq!(KnossosChecker::extract_count(":ok-count", ":ok-count"), 0);
+    }
+
+    #[test]
+    fn parse_output_with_extra_whitespace() {
